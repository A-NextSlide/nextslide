{
  "name": "nextslide-desktop",
  "version": "1.0.0",
  "description": "NextSlide Desktop - AI-powered slide generation",
  "author": "NextSlide <team@nextslide.ai>",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "pack:mac": "tsc && electron-builder --mac",
    "pack:win": "tsc && electron-builder --win",
    "pack:linux": "tsc && electron-builder --linux"
  },
  "build": {
    "appId": "ai.nextslide.desktop",
    "productName": "NextSlide",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "A-NextSlide",
      "repo": "nextslide"
    },
    "protocols": {
      "name": "NextSlide",
      "schemes": [
        "nextslide"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.0"
  }
}
