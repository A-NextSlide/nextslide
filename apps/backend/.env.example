# ============================================================
# NextSlide Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ── AI / LLM Providers ──────────────────────────────────────

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ASSISTANT_ID=your-openai-assistant-id-here

# Google / Gemini
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_COMPOSER_MODEL=gemini-2.5-pro
USE_GEMINI_FOR_COMPOSER=true

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Groq
GROQ_API_KEY=your-groq-api-key-here

# SambaNova
SAMBA_API_KEY=your-samba-api-key-here

# Perplexity (used for outline generation and research)
PPLX_API_KEY=your-perplexity-api-key-here
USE_PERPLEXITY_FOR_OUTLINE=true
USE_PERPLEXITY_FOR_RESEARCH=true

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ── Database ─────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Direct database connection (used for Brandfetch caching)
DATABASE_URL=postgresql://postgres:your-password@your-host:6543/postgres

# ── Auth ─────────────────────────────────────────────────────

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:9090/api/google/auth/callback

# Token encryption
TOKEN_ENCRYPTION_KEY=your-base64-encryption-key-here

# ── Payments ─────────────────────────────────────────────────

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_PRICE_STARTER=price_your-starter-price-id-here
STRIPE_PRICE_PRO=price_your-pro-price-id-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ── Image / Media APIs ───────────────────────────────────────

# Pexels (stock photos)
PEXELS_API_KEY=your-pexels-api-key-here

# Unsplash (stock photos)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_APPLICATION_ID=your-unsplash-app-id-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# Toggle image search
DISABLE_IMAGE_SEARCH=false

# ── Search / Data APIs ───────────────────────────────────────

# SerpAPI (search engine results)
SERPAPI_API_KEY=your-serpapi-key-here
SERPAPI_KEY=your-serpapi-key-here

# Apollo (enrichment)
APOLLO_API_KEY=your-apollo-api-key-here

# ── Brand / Logo APIs ────────────────────────────────────────

# Brandfetch
BRANDFETCH_BRAND_API_KEY=your-brandfetch-brand-api-key-here
BRANDFETCH_LOGO_API_KEY=your-brandfetch-logo-api-key-here

# Logo.dev
LOGODEV_PUBLIC_KEY=your-logodev-public-key-here
LOGODEV_PRIVATE_KEY=your-logodev-private-key-here

# ── Email ────────────────────────────────────────────────────

# Resend (transactional email)
RESEND_API_KEY=your-resend-api-key-here

# ── Observability / Tracing ──────────────────────────────────

# Sentry (error tracking)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# LangChain / LangSmith (LLM tracing)
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=slide-backend
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true

# Phoenix / Arize (LLM observability)
PHOENIX_CLIENT_HEADERS=api_key=your-phoenix-api-key-here
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com

# PostHog (product analytics)
POSTHOG_API_KEY=your-posthog-api-key-here
POSTHOG_HOST=https://us.i.posthog.com

# ── Integrations ─────────────────────────────────────────────

# Nango (OAuth integrations)
NANGO_SECRET_KEY=your-nango-secret-key-here

# Chatbase (AI support widget)
CHATBASE_IDENTITY_SECRET=your-chatbase-identity-secret-here

# Slack Integration
SLACK_APP_ID=your-slack-app-id-here
SLACK_CLIENT_ID=your-slack-client-id-here
SLACK_CLIENT_SECRET=your-slack-client-secret-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_TOKEN_ENCRYPTION_KEY=your-slack-token-encryption-key-here

# ── Serverless / Infrastructure ──────────────────────────────

# Modal (serverless compute)
USE_MODAL=true
MODAL_TOKEN_ID=your-modal-token-id-here
MODAL_TOKEN_SECRET=your-modal-token-secret-here

# ── Feature Flags / App Config ───────────────────────────────

# Agent behavior
AGENT_AUTO_APPLY=true

# Streaming settings
ENABLE_STREAMING=true
STREAMING_MIN_COMPONENTS_UPDATE=3
STREAMING_UPDATE_INTERVAL=5.0

# Prompt and generation toggles
USE_CACHE=false
USE_CONDENSED_PROMPTS=false
USE_REFACTORED_DECK_COMPOSER=true
USE_HTML_INSPIRED=true
QUIET_REGISTRY=true

# Frontend URL (for CORS, redirects, etc.)
FRONTEND_URL=http://localhost:8080

# ── Seed Scripts ─────────────────────────────────────────────
# Only needed when running scripts in apps/backend/scripts/

# API key for seed scripts (required by seed_*.py)
# SEED_API_KEY=your-seed-api-key-here
# SEED_USER_ID=your-seed-user-uuid-here
