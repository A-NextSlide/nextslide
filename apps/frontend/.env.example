# ============================================================
# NextSlide Frontend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# All frontend env vars MUST start with VITE_ to be exposed
# to the browser at build time.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ── App Mode ─────────────────────────────────────────────────

VITE_MODE=development
NODE_ENV=development

# ── API URLs ─────────────────────────────────────────────────

# Local development - use relative URLs so it works via proxy
VITE_API_URL=/api
VITE_AGENT_API_URL=

# Production examples (uncomment and set as needed):
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_AGENT_API_URL=https://your-backend.onrender.com

# WebSocket URL for real-time updates
VITE_WEBSOCKET_URL=wss://your-websocket-server.onrender.com

# ── AI / LLM ────────────────────────────────────────────────

# OpenAI (used for client-side assistant features)
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_ASSISTANT_ID=your-openai-assistant-id-here

# ── Auth ─────────────────────────────────────────────────────

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Google API (for Google Slides / Drive integration)
VITE_GOOGLE_API_KEY=your-google-api-key-here
VITE_GOOGLE_API_SCOPES=https://www.googleapis.com/auth/presentations.readonly,https://www.googleapis.com/auth/drive.readonly

# ── Database / Backend-as-a-Service ──────────────────────────

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Feature Flags / App Config ───────────────────────────────

# Enable renderer route for backend integration
VITE_RENDERER=true

# ── Analytics & Support ──────────────────────────────────────

# PostHog (product analytics)
VITE_POSTHOG_KEY=your-posthog-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Chatbase (AI support widget)
VITE_CHATBASE_BOT_ID=your-chatbase-bot-id-here
# VITE_CHATBASE_DOMAIN=chat.yourdomain.com
