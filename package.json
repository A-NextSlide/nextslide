{
  "name": "nextslide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:backend": "cd apps/backend && ./venv/bin/python -m api.chat_server",
    "build": "cd apps/frontend && npm install --legacy-peer-deps && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "test:frontend": "cd apps/frontend && npm run test",
    "kill": "cd apps/backend && make kill-all",
    "restart": "npm run kill && npm run dev",
    "nextslide": "npm-run-all --parallel dev:frontend dev:backend",
    "nextslide:restart": "npm run kill && npm run nextslide",
    "dev:mobile": "cd apps/mobile && npm run dev",
    "dev:mobile:ios": "cd apps/mobile && npm run dev:ios",
    "dev:mobile:android": "cd apps/mobile && npm run dev:android",
    "build:mobile:dev": "cd apps/mobile && npm run build:dev",
    "build:mobile:preview": "cd apps/mobile && npm run build:preview",
    "build:mobile:prod": "cd apps/mobile && npm run build:prod",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "build:desktop:mac": "cd apps/desktop && npm run pack:mac",
    "build:desktop:win": "cd apps/desktop && npm run pack:win",
    "build:desktop:linux": "cd apps/desktop && npm run pack:linux",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {},
  "description": "NextSlide monorepo - AI-powered slide generation platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/nextslide.git"
  },
  "keywords": [
    "slides",
    "presentation",
    "ai",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
